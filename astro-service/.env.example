# --- Service ---
LOG_LEVEL=INFO

# --- Nominatim ---
# Primary geocoder. Public OSM by default; point at an instance you own to
# lift the rate limit below.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional secondary instance, merged with the primary. Empty = primary only.
NOMINATIM_FALLBACK_URL=
# Required by the public OSM instance: an empty or library-default User-Agent
# gets a 403 that looks exactly like an IP ban. Put a real contact here.
NOMINATIM_USER_AGENT=astro-service/1.0 (you@example.com)
GEOCODING_TIMEOUT=10.0
GEOCODING_LANGUAGE=ru

# --- Geocoding throughput ---
# Outbound budget per instance, requests/second. The public OSM instance
# allows 1 req/s per APPLICATION across all users. Set to 0 only when
# NOMINATIM_URL points at an instance you own.
NOMINATIM_RATE_LIMIT=1
NOMINATIM_FALLBACK_RATE_LIMIT=1
# Only relevant when a fallback is configured: query both instances and merge
# instead of stopping at the first non-empty answer. Keep true unless the
# primary covers the whole planet — with a regional primary, a same-named city
# inside the region hides the one the user meant (Odessa UA vs Odessa TX) and
# the chart is built on the wrong coordinates and timezone.
GEOCODING_MERGE_SOURCES=true
# Max seconds a request may sit in the outbound queue before a 503.
GEOCODING_QUEUE_MAX_WAIT=8
# Result cache — what actually makes a 1 req/s budget usable.
GEOCODING_CACHE_SIZE=5000
GEOCODING_CACHE_TTL=86400

# --- Ephemeris ---
# House system: P=Placidus, K=Koch, W=Whole Sign, R=Regiomontanus, ...
HOUSES_SYSTEM=P
# Zodiac type: Tropic | Sidereal
ZODIAC_TYPE=Tropic
