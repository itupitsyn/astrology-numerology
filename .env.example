# Copy to .env on the server (it is gitignored). docker compose reads it automatically.

# --- Postgres ---
# CHANGE THIS in production.
POSTGRES_PASSWORD=astro

# --- Web ---
WEB_PORT=3000

# --- LLM (external llama.cpp, OpenAI-compatible) ---
# Required. The model id is auto-detected from the server's /v1/models.
NUXT_LLM_BASE_URL=
# Optional bearer token, if the LLM server requires auth.
NUXT_LLM_API_KEY=

# Outbound budget for the LLM. The model runs on ONE GPU: past a couple of
# concurrent generations everybody just gets slower and then times out together.
# Requests beyond the limit queue; one that waits longer than the max wait is
# answered "busy" instead of hanging.
NUXT_LLM_CONCURRENCY=1
NUXT_LLM_QUEUE_MAX_WAIT_MS=60000
NUXT_LLM_QUEUE_MAX_SIZE=50

# --- Bot / daily forecast ---
# Shared secret the Telegram bot presents as X-API-Key on /api/bot/*. REQUIRED
# for those routes — they can start a GPU job, so they are not left open.
# Generate with: openssl rand -hex 32
NUXT_BOT_API_KEY=
# Bot token from @BotFather. Used by the web layer ONLY to verify Mini App
# initData signatures (that is how /api/profile identifies the caller without a
# token table of our own), and by the bot container to talk to Telegram. It must
# be the SAME bot in both places, or every /setup request fails its signature
# check.
NUXT_TELEGRAM_BOT_TOKEN=
# Public origin of the web app. Used to build the setup link the bot sends to a
# user who has no profile yet. Telegram only opens Mini Apps over HTTPS, so in
# production this must be an https:// address.
NUXT_APP_URL=http://localhost:3000

# How long the bot keeps checking for the forecast text before telling the user
# to come back. The facts are sent instantly either way.
BOT_POLL_INTERVAL_MS=2000
BOT_POLL_TIMEOUT_MS=180000

# Proxy for reaching api.telegram.org where Telegram is blocked. Leave empty if
# the server can reach Telegram directly.
#   http://user:pass@proxy.example.com:3128   or   socks5://127.0.0.1:1080
# Applied to Telegram traffic ONLY. Do NOT set a global HTTP_PROXY/HTTPS_PROXY
# instead: the bot also calls the web layer at an internal address, and routing
# that through an external proxy makes it hang until it times out.
TELEGRAM_PROXY_URL=

# --- Geocoding ---
# Primary. Public OSM by default; point at your own instance to lift the limit.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Fallback: other regions / rest of world. Empty = primary only.
NOMINATIM_FALLBACK_URL=
# Put a real contact here per Nominatim usage policy (required by public OSM).
# An empty or library-default UA gets 403 from the public instance.
NOMINATIM_USER_AGENT=astro-numerology-app/1.0 (you@example.com)
GEOCODING_LANGUAGE=ru

# Outbound budget, requests/second. The public OSM instance allows 1 req/s per
# APPLICATION, counted across all users — keep this at 1 while NOMINATIM_URL
# points there. Set to 0 only for an instance you own.
NOMINATIM_RATE_LIMIT=1
NOMINATIM_FALLBACK_RATE_LIMIT=1
# Only relevant when a fallback is set: query both and merge. With a REGIONAL
# primary this is required for correctness — a city of the same name inside
# the region would otherwise hide the one the user meant, and the chart would
# be built on the wrong coordinates and timezone.
GEOCODING_MERGE_SOURCES=true
# Max seconds a request may queue before the API answers 503 (Retry-After: 2).
GEOCODING_QUEUE_MAX_WAIT=8
# Result cache. Birth places repeat heavily, so this is what keeps a 1 req/s
# budget from being the app's throughput ceiling.
GEOCODING_CACHE_SIZE=5000
GEOCODING_CACHE_TTL=86400
